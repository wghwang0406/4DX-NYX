{
  "name": "@conti/viewer",
  "private": true,
  "version": "0.0.1",
  "description": "NYX 사내 뷰어 서버 — 게시본 보관(Dropbox), 토큰 링크, 컷·영역·타임코드 코멘트, 판정",
  "type": "module",
  "main": "./src/server/app.ts",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build web && esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:node:*",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
